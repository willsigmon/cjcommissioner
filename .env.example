# Public site configuration
NEXT_PUBLIC_SITE_URL=https://cjcommissioner.com
NEXT_PUBLIC_VOLUNTEER_ENABLED=false
ALLOWED_ORIGINS=https://cjcommissioner.com,https://www.cjcommissioner.com

# Stripe — use test keys in Preview and live keys only in Production
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Private contribution ledger — use a campaign-dedicated Supabase project
SUPABASE_URL=https://replace-me.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me
DONATION_FINGERPRINT_SECRET=replace_with_at_least_32_random_characters
DONATION_ELECTION_SLUG=2026-general
DONATION_EXPORT_TOKEN=replace_with_at_least_32_random_characters

# All three flags must be true before the server creates a Checkout Session
DONATIONS_ENABLED=false
TREASURER_COPY_APPROVED=false
CONTRIBUTION_HISTORY_RECONCILED=false

# Google Sheets — dedicated campaign-owned Sheet and append-only service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=website-volunteer@example-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=replace_me
GOOGLE_SHEET_TAB=Website Volunteers - Test

# Vercel Firewall rule configured for 5 requests per IP per 10 minutes
VERCEL_VOLUNTEER_RATE_LIMIT_ID=volunteer-form

# Separate Vercel Firewall rule for contribution session creation
VERCEL_DONATION_RATE_LIMIT_ID=donation-session
